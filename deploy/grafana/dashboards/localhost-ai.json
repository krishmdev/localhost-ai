    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 decode-step time vs TPOT SLO",
      "description": "The controller watches decode-step time: above the SLO line it shrinks L by 20%; below 90% of it (with a saturated batch and memory headroom) it grows L by 10%. The iteration line adds prefill stalls, which is what a stream feels.",
      "datasource": {
        "type": "prometheus",
        "uid": "lhai-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lhai-prom"
          },
          "expr": "lhai_decode_step_p95_seconds",
          "legendFormat": "p95 decode step",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lhai-prom"
          },
          "expr": "lhai_slo_tpot_seconds",
          "legendFormat": "SLO",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lhai-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lhai_step_seconds_bucket[30s])))",
          "legendFormat": "p95 iteration (incl. prefill)",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "drawStyle": "line",
            "axisBorderShow": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 decode step"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c3c2b7"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 iteration (incl. prefill)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
